{
  "scopeName": "source.emojineer",
  "name": "Emojineer",
  "patterns": [
    { "name": "comment.line.emojineer", "match": "💭.*$" },
    { "name": "string.quoted.other.emojineer", "begin": "📜", "end": "📜" },
    { "name": "constant.numeric.emojineer", "match": "(?<![0-9])(?:[0-9]+(?:\\.[0-9]+)?)(?![0-9])" },
    { "name": "constant.language.boolean.emojineer", "match": "(?:✅|❌)" },
    { "name": "storage.type.emojineer", "match": "(?:🔢|🔤|🎯|📚)" },
    { "name": "keyword.control.emojineer", "match": "(?:🤔|🙅|🔁|🏁|📦)" },
    { "name": "keyword.declaration.emojineer", "match": "(?:🐍|✏️|🛠️|🧩|🔗|📤|🔌|📡)" },
    { "name": "keyword.operator.emojineer", "match": "(?:➕|➖|✖️|➗|🪄|🟰|🔽|🔼|🚫|🔎|📏|📎|🧷)" }
  ]
}
